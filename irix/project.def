dir VIDEO_X11=../src/video/x11 *.c

dir TESTAUTOMATION=../test testautomation.c testautomation*.c

lib SDL2 SRC ATOMIC AUDIO AUDIO_DISK AUDIO_DMEDIA AUDIO_DM UNIX CPUINFO DYNAPI EVENTS FILE FS HAPTIC HAPTIC_DM HIDAPI JOY JOY_DM LOADSO LOCALE LOCALE_UX MISC MISC_UX POWER RENDER RENDER_OGL RENDER_SW SENSOR SENSOR_DM STDLIB THREAD PTHREAD TIMER TIMER_IRIX VIDEO VIDEO_YUV VIDEO_DM VIDEO_X11

dir TEST=../src/test *.c
lib TEST

exe testautomation TESTAUTOMATION
   dep SDL2 TEST

